# GraphQL Endpoint
ENDPOINT=http://localhost:4000/graphql

# Server name (optional)
# NAME=mcp-graphql

# Allow mutations (default: false)
# ALLOW_MUTATIONS=false

# Custom headers as JSON string (optional)
# HEADERS={"X-Api-Key":"your-api-key"}

# Local or remote schema file (optional, overrides endpoint introspection)
# SCHEMA=./schema.graphql

# MCP Server URL (optional)
# MCP_URL=http://localhost:3000

# OAuth Configuration (all optional — without these the server runs without auth)
# OAUTH_ISSUER=https://login.example.com
# OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# OAUTH_AUTH_ENDPOINT=https://login.example.com/oauth2/authorize
# OAUTH_TOKEN_ENDPOINT=https://login.example.com/oauth2/token
# OAUTH_AUDIENCE=my-api
# OAUTH_SCOPES=openid,profile,email
